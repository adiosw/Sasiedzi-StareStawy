# ==================================================
# STARE STAWY — SĄSIEDZI: KONFIGURACJA ŚRODOWISKA
# ==================================================

# Supabase (Baza danych, Auth, Storage, RLS)
# Pobierz z panelu Supabase: Project Settings -> API
VITE_SUPABASE_URL="https://twój-projekt.supabase.co"
VITE_SUPABASE_ANON_KEY="twój-publiczny-anon-key"

# Tryb demonstracyjny / Offline:
# Gdy zmienne Supabase nie są ustawione, aplikacja automatycznie
# przełącza się w pełny tryb lokalny z danymi demonstracyjnymi (DEMO SEED),
# umożliwiając natychmiastowe testowanie wszystkich funkcji bez konfiguracji serwera!
VITE_ENABLE_DEMO_SEED="true"

# Web Push Notifications (opcjonalne dla PWA powiadomień)
# Wygeneruj parę kluczy VAPID (np. przez npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=""

# Google AI Studio / Gemini API (opcjonalne, wstrzykiwane automatycznie w chmurze)
GEMINI_API_KEY=""

# Publiczny adres URL aplikacji (np. https://twojadomena.pl lub url z Vercel/Cloud Run)
APP_URL="http://localhost:3000"
